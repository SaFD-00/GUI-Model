# OpenRouter (OpenAI-compatible Chat Completions).
#
# 쓰이는 곳은 두 군데다: input_text action 의 입력값 생성, 그리고 semantic 라벨링
# (page/element 라벨 + same-function 그룹핑). 둘 다 없으면 열화 경로로 떨어질 뿐
# 수집 자체는 계속 돈다 — 라벨은 structure 해시가 되고, 가지치기가 사라지고,
# 입력 텍스트는 고정 샘플에서 나온다. page 식별은 애초에 LLM 을 타지 않는다.
OPENROUTER_API_KEY=sk-or-your-api-key-here

# 선택 override. 모델 기본값은 여기가 아니라 config/run.yaml 의 `llm.model` 이 정본이고,
# 해석 순서는 명시 인자 → OPENROUTER_MODEL → config → 코드 기본값이다.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=qwen/qwen3.8-flash

# Android SDK (adb 를 PATH 밖에서 찾아야 할 때)
# ANDROID_HOME=/opt/android/sdk

# 설정은 MC_{SECTION}_{KEY} 로도 덮을 수 있다 (config/run.yaml 참조).
# 예: MC_DEVICE_SERIAL / MC_COLLECTION_MAX_DURATION / MC_LLM_INPUT_MODE
